# Local development / test only. Copy to .env (git-ignored) and adjust.
# Production values are set privately in Render → Environment; never commit them.
APP_ENV=development
APP_PASSWORD=local-dev-only-password
FLASK_SECRET_KEY=local-dev-only-signing-key-not-for-production-use
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/sb_price_checker_dev
DATABASE_SSL=disable
